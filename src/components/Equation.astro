---
// KaTeX rendered at build time: static HTML, no math JS in the browser.
import katex from "katex";
import "katex/dist/katex.min.css";

interface Props {
  tex: string;
  /** Short caption under the equation. */
  caption?: string;
  inline?: boolean;
}

const { tex, caption, inline = false } = Astro.props;
// \textcolor uses the dark palette's hex; swap each for its token so equations follow the theme.
const TOKEN_HEX: Record<string, string> = {
  "#00E1FF": "cyan",
  "#FFB300": "amber",
  "#FF2E93": "magenta",
  "#2BFF6E": "lime",
  "#2F86FF": "blue",
  "#FF2B2B": "alert",
  "#FF4136": "x",
  "#FF8A00": "y",
  "#FFE033": "z",
};
const html = katex
  .renderToString(tex, { displayMode: !inline, throwOnError: false, trust: true, strict: false })
  .replace(/color:\s*(#[0-9a-f]{6})/gi, (m, hex: string) => {
    const t = TOKEN_HEX[hex.toUpperCase()];
    return t ? `color:var(--${t})` : m;
  });
---

{
  inline ? (
    <span class="eq-inline" set:html={html} />
  ) : (
    <figure class="eq">
      <div set:html={html} />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .eq {
    margin: 28px 0;
    padding: 20px 16px;
    border-top: 1px solid var(--grid);
    border-bottom: 1px solid var(--grid);
    overflow-x: auto;
    font-size: 1.1em;
  }
  .eq :global(.katex-display) {
    margin: 0;
  }
  figcaption {
    margin-top: 10px;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
</style>
