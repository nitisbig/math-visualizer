---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Thumb from "../components/Thumb.astro";
import { CATEGORIES, SITE } from "../site.config";

const concepts = (await getCollection("concepts", (c) => !c.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, concepts.filter((x) => x.data.category === c).length]));
---

<Base>
  <section class="wrap hero">
    <p class="eyebrow">Interactive math</p>
    <h1>Don’t just watch it.<br /><span>Play with it.</span></h1>
    <p class="lede">{SITE.tagline}</p>
  </section>

  <section class="wrap" id="concepts" aria-labelledby="concepts-h">
    <div class="list-head">
      <h2 id="concepts-h">Concepts <span class="count">{concepts.length}</span></h2>
      <div class="chips" role="group" aria-label="Filter by field">
        <button type="button" class="chip on" data-filter="all" aria-pressed="true">All</button>
        {
          CATEGORIES.filter((c) => counts[c] > 0).map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
    </div>

    <ul class="grid">
      {
        concepts.map((c, i) => (
          <li data-category={c.data.category}>
            <a href={`/${c.id}/`} class="card">
              <div class="thumb-wrap">
                <Thumb slug={c.id} />
              </div>
              <div class="card-body">
                <span class="meta">
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  {c.data.category}
                </span>
                <h3>{c.data.title}</h3>
                <p>{c.data.hook}</p>
              </div>
              <span class="go" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more">More concepts arrive with each new video.</p>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const items = document.querySelectorAll<HTMLElement>(".grid > li");
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        c.classList.toggle("on", c === chip);
        c.setAttribute("aria-pressed", String(c === chip));
      });
      items.forEach((li) => (li.hidden = f !== "all" && li.dataset.category !== f));
    }),
  );
</script>

<style>
  .hero,
  #concepts {
    max-width: var(--max-wide);
  }
  .hero {
    padding: 96px var(--gutter) 72px;
  }
  .hero h1 {
    margin: 16px 0 20px;
    font-size: clamp(42px, 7.5vw, 84px);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .hero h1 span {
    background: linear-gradient(90deg, var(--cyan), var(--blue));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    max-width: 30em;
    margin: 0;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--muted);
  }
  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .list-head h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 20px;
    font-weight: 500;
  }
  .count {
    font: 400 12px var(--font-mono);
    color: var(--muted);
  }
  .chips {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--hair);
    border-radius: 999px;
    background: var(--s1);
  }
  .chip {
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font: 500 13px var(--font-body);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .chip:hover {
    color: var(--ink-2);
  }
  .chip.on {
    color: var(--ink);
    background: var(--s3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-lg);
    background: var(--s1);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .thumb-wrap {
    background: radial-gradient(120% 100% at 50% 0%, #0b1018, #000 70%);
    border-bottom: 1px solid var(--hair);
  }
  .card-body {
    padding: 18px 20px 22px;
  }
  .meta {
    display: flex;
    gap: 10px;
    font: 400 11px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .num {
    color: var(--ink-2);
  }
  .card h3 {
    margin: 10px 0 8px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .go {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--hair-2);
    border-radius: 50%;
    background: var(--glass);
    color: var(--ink);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s, transform 0.25s var(--ease-out);
  }
  .go svg {
    width: 14px;
    height: 14px;
  }
  .card:hover .go {
    opacity: 1;
    transform: none;
  }
  .more {
    margin-top: 28px;
    font-size: 13px;
    color: var(--muted);
  }

  /* Phones: an app-style list */
  @media (max-width: 640px) {
    .hero {
      padding: 48px var(--gutter) 40px;
    }
    .chips {
      overflow-x: auto;
      max-width: 100%;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .card {
      flex-direction: row;
      align-items: center;
      border-radius: var(--r-md);
    }
    .thumb-wrap {
      flex: none;
      width: 112px;
      align-self: stretch;
      display: grid;
      place-items: center;
      border-bottom: 0;
      border-right: 1px solid var(--hair);
    }
    .card-body {
      min-width: 0;
      padding: 14px 40px 14px 16px;
    }
    .card h3 {
      margin: 6px 0 4px;
      font-size: 17px;
    }
    .card p {
      font-size: 13px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .go {
      top: 50%;
      right: 12px;
      margin-top: -16px;
      opacity: 1;
      transform: none;
      border: 0;
      background: none;
      color: var(--muted);
    }
    .card:hover {
      transform: none;
    }
  }
</style>
