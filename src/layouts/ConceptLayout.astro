---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import LiteYouTube from "../components/LiteYouTube.astro";
import { existsSync } from "node:fs";

interface Props {
  concept: CollectionEntry<"concepts">;
  next?: CollectionEntry<"concepts">;
}

const { concept, next } = Astro.props;
const { title, category, hook, description, videoId, videoTitle } = concept.data;
// Per-concept share card if one exists in public/og/, else the site card.
const og = existsSync(`public/og/${concept.id}.png`) ? `/og/${concept.id}.png` : undefined;
// Pages built from Workspaces get the phone app layout (one pane at a time + tab bar).
const body = await Astro.slots.render("default");
const app = body.includes("data-workspace");
---

<Base title={title} description={description} image={og} appTitle={app ? title : undefined}>
  {
    app && (
      <div class="focus-bar">
        <a href="/" class="focus-home" aria-label="All concepts">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 18 C 7 18, 8 6, 12 6 S 17 18, 22 18" fill="none" stroke="var(--cyan)" stroke-width="2" stroke-linecap="round" />
            <circle cx="12" cy="6" r="2.4" fill="var(--amber)" />
          </svg>
        </a>
        <h1 class="focus-title">{title}</h1>
        <button type="button" class="reveal" data-reveal>
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.5" width="4.5" height="4.5" rx="1.2" /><rect x="9" y="2.5" width="4.5" height="4.5" rx="1.2" /><rect x="2.5" y="9" width="4.5" height="4.5" rx="1.2" /><rect x="9" y="9" width="4.5" height="4.5" rx="1.2" /></svg>
          Reveal everything
        </button>
      </div>
    )
  }
  <div class="wrap concept">
    <div class="panes" data-panes data-active="intro" data-app={app ? "" : undefined}>
      <header class="intro active" id="intro" data-pane="intro">
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="hook">{hook}</p>
        <div class="intro-actions">
          <button type="button" class="start" data-start>
            Start exploring
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          {
            videoId && (
              <a href="#watch" class="watch">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6c0 .5.6.8 1 .5l7.4-4.8a.6.6 0 0 0 0-1L6 2.7c-.4-.3-1 0-1 .5z" /></svg>
                Watch the video
              </a>
            )
          }
          {
            app && (
              <button type="button" class="watch" data-focus-btn>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 6V3.5a1 1 0 0 1 1-1H6M10 2.5h2.5a1 1 0 0 1 1 1V6M13.5 10v2.5a1 1 0 0 1-1 1H10M6 13.5H3.5a1 1 0 0 1-1-1V10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                Focus mode
              </button>
            )
          }
        </div>
      </header>

      <Fragment set:html={body} />

      <div class="outro">
        {
          videoId && (
            <section class="video" id="watch" aria-labelledby="watch-h">
              <h2 id="watch-h" class="eyebrow">The video</h2>
              <LiteYouTube id={videoId} title={videoTitle ?? title} />
            </section>
          )
        }
        {
          next && (
            <a class="next" href={`/${next.id}/`}>
              <span class="eyebrow">Next concept</span>
              <span class="next-title">{next.data.title}</span>
              <span class="next-hook">{next.data.hook}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <nav class="tabbar" aria-label="Sections" data-tabbar hidden={!app}>
    <button type="button" data-tab="intro" class="on" aria-current="page">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M7 8h6M7 11.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      <span>Intro</span>
    </button>
  </nav>
</Base>

<script>
  // Builds the phone tab bar from the page's workspaces,
  // shows one pane at a time on phones, and keeps the active one in the hash.
  const panes = document.querySelector<HTMLElement>("[data-panes]")!;
  const tabbar = document.querySelector<HTMLElement>("[data-tabbar]")!;
  const workspaces = [...document.querySelectorAll<HTMLElement>("[data-workspace]")];
  const phone = window.matchMedia("(max-width: 767px)");

  // Islands wrap each workspace in <astro-island>; toggle that wrapper so Preact never sees the class.
  const paneOf = new Map<string, HTMLElement>([["intro", document.getElementById("intro")!]]);
  workspaces.forEach((ws, i) => {
    paneOf.set(ws.id, (ws.closest("astro-island") as HTMLElement) ?? ws);
    const b = document.createElement("button");
    b.type = "button";
    b.dataset.tab = ws.id;
    b.innerHTML = `<span class="tab-n">${i + 1}</span><span></span>`;
    b.lastElementChild!.textContent = ws.dataset.tab ?? ws.id;
    tabbar.append(b);
  });

  function show(id: string, push = true) {
    if (!paneOf.has(id)) id = "intro";
    panes.dataset.active = id;
    paneOf.forEach((el, k) => el.classList.toggle("active", k === id));
    tabbar.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
      const on = b.dataset.tab === id;
      b.classList.toggle("on", on);
      if (on) b.setAttribute("aria-current", "page");
      else b.removeAttribute("aria-current");
    });
    if (push) {
      const url = new URL(location.href);
      url.hash = id === "intro" ? "" : id;
      history.replaceState(null, "", url);
    }
    window.scrollTo(0, 0);
  }

  tabbar.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-tab]");
    if (b) show(b.dataset.tab!);
  });

  document.querySelector("[data-start]")?.addEventListener("click", () => {
    const first = workspaces[0];
    if (!first) return;
    if (app && phone.matches) show(first.id);
    else first.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  document.querySelector<HTMLAnchorElement>(".watch")?.addEventListener("click", (e) => {
    if (!app || !phone.matches) return;
    e.preventDefault();
    show("intro", false);
    document.getElementById("watch")?.scrollIntoView({ block: "start" });
  });

  const fromHash = () => decodeURIComponent(location.hash.slice(1));
  const app = panes.hasAttribute("data-app");
  if (app && phone.matches && fromHash()) show(fromHash(), false);
  window.addEventListener("hashchange", () => {
    if (fromHash()) setFocus(false, false);
    if (app && phone.matches) show(fromHash(), false);
  });

  // Focus view (opt-in): the first canvas alone, full screen. Reveal morphs it back into its slot.
  const root = document.documentElement;
  function setFocus(on: boolean, animate = true) {
    if (on === root.hasAttribute("data-focus")) return;
    const first = workspaces[0];
    const apply = () => {
      if (on) root.dataset.focus = "";
      else delete root.dataset.focus;
      if (on || !first) window.scrollTo(0, 0);
      else if (app && phone.matches) show(first.id, false);
      else first.scrollIntoView({ block: "start" });
    };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (animate && !reduce && document.startViewTransition) document.startViewTransition(apply);
    else apply();
  }
  document.querySelector("[data-reveal]")?.addEventListener("click", () => setFocus(false));
  document.querySelector("[data-focus-btn]")?.addEventListener("click", () => setFocus(true));
  document.addEventListener("keydown", (e) => e.key === "Escape" && setFocus(false));
</script>

<style>
  .concept {
    max-width: var(--max-wide);
    counter-reset: ws;
  }
  .panes {
    min-width: 0;
  }

  /* Loose MDX prose between widgets (pages not yet built from Workspaces). */
  .panes > :global(:where(h2, h3, p, ol, ul)) {
    max-width: 760px;
  }
  .panes > :global(h2) {
    margin: 56px 0 14px;
    font-size: 24px;
  }
  .panes > :global(h3) {
    margin: 32px 0 10px;
    font-size: 18px;
  }
  .panes > :global(:where(p, ul, ol)) {
    color: var(--ink-2);
  }
  .panes > :global(:where(ul, ol)) {
    display: grid;
    gap: 10px;
    padding-left: 20px;
  }

  /* Intro */
  .intro {
    padding: 64px 0 40px;
  }
  .intro h1 {
    max-width: 14em;
    margin: 12px 0 14px;
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.025em;
  }
  .hook {
    max-width: 36em;
    margin: 0;
    font-size: clamp(16px, 1.8vw, 19px);
    color: var(--ink-2);
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .start,
  .watch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font: 500 14px var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .start {
    border: 0;
    background: var(--ink);
    color: var(--bg);
  }
  .start:hover {
    background: #fff;
  }
  .watch {
    border: 1px solid var(--hair-2);
    background: transparent;
    color: var(--ink);
  }
  .watch:hover {
    border-color: rgba(255, 255, 255, 0.22);
    background: var(--s2);
  }
  .start svg,
  .watch svg {
    width: 14px;
    height: 14px;
  }
  .watch svg {
    fill: currentColor;
  }

  /* Outro */
  .outro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
    margin-top: 16px;
  }
  .video .eyebrow {
    margin: 0 0 12px;
    font-weight: 400;
  }
  .next {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 24px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-lg);
    background: linear-gradient(160deg, var(--s2), var(--s1));
    text-decoration: none;
    transition: border-color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .video + .next {
    margin-top: 30px;
  }
  .next:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }
  .next-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
  }
  .next-title::after {
    content: " →";
    color: var(--muted);
  }
  .next-hook {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .outro {
      grid-template-columns: 1fr;
    }
    .video + .next {
      margin-top: 0;
    }
  }

  /* Tab bar: phones only */
  .tabbar {
    display: none;
  }

  @media (max-width: 767px) {
    .concept {
      padding: 0;
    }
    .panes[data-app] > :global(:not(.active):not(.outro)) {
      display: none;
    }
    .panes[data-app]:not([data-active="intro"]) > .outro {
      display: none;
    }
    .intro {
      padding: 36px var(--gutter) 28px;
    }
    .outro {
      padding: 0 var(--gutter) calc(var(--tabbar) + var(--safe-b) + 24px);
    }
    .tabbar:not([hidden]) {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      display: flex;
      height: calc(var(--tabbar) + var(--safe-b));
      padding: 0 8px var(--safe-b);
      border-top: 1px solid var(--hair);
      background: rgba(0, 0, 0, 0.82);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      backdrop-filter: blur(18px) saturate(140%);
    }
    .tabbar :global(button) {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border: 0;
      background: none;
      color: var(--muted);
      font: 500 11px var(--font-body);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .tabbar :global(button > span:last-child) {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .tabbar :global(svg) {
      width: 20px;
      height: 20px;
    }
    .tabbar :global(.tab-n) {
      display: grid;
      place-items: center;
      width: 20px;
      height: 20px;
      border: 1.6px solid currentColor;
      border-radius: 6px;
      font: 500 11px var(--font-mono);
    }
    .tabbar :global(button.on) {
      color: var(--ink);
    }
    .tabbar :global(button.on .tab-n) {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--bg);
    }
  }
</style>

<style is:global>
  /* ================= Focus view =================
     Opened from "Focus mode": the first workspace's canvas fills the screen with only the
     title, its transport and "Reveal everything". Toggled by html[data-focus]. */
  .focus-bar {
    display: none;
  }
  html[data-focus] .focus-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: calc(16px + env(safe-area-inset-top, 0px)) var(--gutter) 28px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent);
    pointer-events: none;
    animation: focus-in 0.5s var(--ease-out) both;
  }
  .focus-bar > * {
    pointer-events: auto;
  }
  .focus-home {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    margin-left: -6px;
    border-radius: 50%;
    transition: background 0.2s;
  }
  .focus-home:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .focus-home svg {
    width: 20px;
    height: 20px;
  }
  .focus-title {
    min-width: 0;
    margin-right: auto;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .reveal {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px 0 13px;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--ink);
    font: 500 13px var(--font-body);
    cursor: pointer;
    transition: background 0.2s var(--ease-out), border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .reveal svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
    opacity: 0.8;
  }
  .reveal:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  html[data-focus] .intro,
  html[data-focus] .outro,
  html[data-focus] .tabbar,
  html[data-focus] .panes > :not(astro-island:first-of-type) {
    display: none !important;
  }
  /* Beats the phone rule that shows only the active pane. */
  html[data-focus] .panes > astro-island:first-of-type {
    display: contents !important;
  }

  html[data-focus] .panes > astro-island:first-of-type .ws {
    --peek: 0px;
    position: fixed;
    inset: 0;
    z-index: 25;
    display: block;
    height: 100svh;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: var(--bg);
  }
  html[data-focus] .panes > astro-island:first-of-type :is(.ws-panel, .ws-status, .ws-coach) {
    display: none;
  }
  html[data-focus] .panes > astro-island:first-of-type .ws-stage {
    position: absolute;
    inset: 0;
    height: auto;
  }

  /* Transport: centred, icon-only, round. */
  html[data-focus] .ws-transport {
    left: 50%;
    right: auto;
    bottom: calc(24px + var(--safe-b));
    transform: translateX(-50%);
    animation: focus-in 0.5s 0.1s var(--ease-out) both;
  }
  html[data-focus] .ws-transport .transport {
    flex-direction: row;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  html[data-focus] .ws-transport .tlabel {
    display: none;
  }
  html[data-focus] .ws-transport .tbtn {
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--hair-2);
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  html[data-focus] .ws-transport .tbtn.play {
    order: 1;
    width: 54px;
    height: 54px;
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
    box-shadow: 0 8px 28px -8px rgba(0, 0, 0, 0.9);
  }
  html[data-focus] .ws-transport .tbtn.play svg {
    width: 18px;
    height: 18px;
  }
  html[data-focus] .ws-transport .tbtn[aria-label="Step"] {
    order: 2;
  }

  /* Reveal / focus morph (View Transitions, where supported). */
  .panes > astro-island:first-of-type .ws-stage {
    view-transition-name: focus-stage;
  }
  ::view-transition-group(focus-stage) {
    animation-duration: 0.55s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.35s;
  }

  @keyframes focus-in {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    html[data-focus] .focus-bar {
      gap: 8px;
      padding-top: calc(12px + env(safe-area-inset-top, 0px));
    }
    .focus-title {
      font-size: 15px;
    }
    .reveal {
      height: 40px;
      padding: 0 14px 0 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-focus] .focus-bar,
    html[data-focus] .ws-transport {
      animation: none;
    }
  }
</style>
